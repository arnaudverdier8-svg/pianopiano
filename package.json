{
  "name": "moonlight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Microphone-first piano practice with a falling-note view. Ships with Debussy's Clair de lune (Mutopia #1778).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:detector": "vitest run src/tests/detector --reporter=verbose",
    "fetch:song": "node scripts/fetch-song.mjs",
    "fetch:samples": "node scripts/fetch-samples.mjs",
    "fetch:fixtures": "node scripts/fetch-fixtures.mjs",
    "inspect:song": "node scripts/inspect-song.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
